# Environment mode (production for hosted deployments, development for local work)
NODE_ENV=production

# Port for the Express server to listen on
PORT=5000

# PostgreSQL connection string for hosted databases (e.g. Neon, Supabase, Render Postgres)
DATABASE_URL=postgres://username:password@hostname:5432/database_name?sslmode=require

# Set to false in production to connect to standard PostgreSQL via DATABASE_URL (true uses embedded PGlite for local dev)
PG_USE_PGLITE=false

# Strong random secret key used for signing session cookies
SESSION_SECRET=replace_with_a_secure_random_string_in_production

# Frontend origin URL for CORS validation (e.g. https://your-domain.com or https://aicte-tracker.onrender.com)
CLIENT_URL=https://your-production-app-domain.com
